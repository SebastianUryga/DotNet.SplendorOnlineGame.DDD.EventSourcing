    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Splendor.Infrastructure\Splendor.Infrastructure.csproj" />
    <ProjectReference Include="..\Splendor.Application\Splendor.Application.csproj" />
    <ProjectReference Include="..\Splendor.Contracts\Splendor.Contracts.csproj" />
  </ItemGroup>

</Project>
